@model UTHMBargain.Models.ApplicationUser
@{
    ViewData["Title"] = Model.FullName; var listings = (List<UTHMBargain.Models.Product>)ViewBag.Listings; var ratings = (List<UTHMBargain.Models.Rating>)ViewBag.Ratings;
}

<div class="card p-4">
    <div class="d-flex align-items-center gap-3 flex-wrap">
        <img src="@(Model.AvatarUrl ?? "/images/avatar.svg")" style="width:88px;height:88px;border-radius:50%;object-fit:cover;background:var(--surface-2);" />
        <div class="flex-fill">
            <h3 class="mb-1">@Model.FullName</h3>
            <div class="text-muted small">@Model.Faculty · @Model.Campus · Matric: @Model.MatricNumber</div>
            <div class="mt-2">
                <span class="stars">@(new string('★', (int)Math.Round((double)ViewBag.AvgStars)))@(new string('☆', 5 - (int)Math.Round((double)ViewBag.AvgStars)))</span>
                <span class="text-muted small">@ViewBag.AvgStars.ToString("F1") · @ViewBag.CompletedDeals deals</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.Bio))
            {
                <p class="text-muted small mt-2 mb-0">@Model.Bio</p>
            }
        </div>
        @if (ViewBag.IsOwn == true)
        {
            <a asp-action="Edit" class="btn btn-outline-light"><i class="fa-solid fa-pen me-1"></i>Edit Profile</a>
        }
    </div>
</div>

<h2 class="section-title mt-4">Listings</h2>
@if (!listings.Any())
{
    <div class="empty"><i class="fa-solid fa-tag"></i><p>No listings yet.</p></div>
}
else
{
    <div class="row g-3">
        @foreach (var p in listings)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none text-reset">
                    <div class="card product-card h-100">
                        <img src="@(p.Images.FirstOrDefault()?.Url ?? "/images/placeholder.svg")" class="card-img-top" />
                        <div class="card-body">
                            <div class="price-tag">RM @p.Price.ToString("F2")</div>
                            <div class="fw-semibold text-truncate mt-1">@p.Title</div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

<h2 class="section-title mt-4">Reviews</h2>
@if (!ratings.Any())
{
    <div class="empty"><i class="fa-solid fa-star"></i><p>No reviews yet.</p></div>
}
else
{
    <div class="row g-3">
        @foreach (var r in ratings)
        {
            <div class="col-md-6">
                <div class="card p-3">
                    <div class="d-flex justify-content-between">
                        <strong>@r.Rater!.FullName</strong>
                        <span class="stars">@(new string('★', r.Stars))@(new string('☆', 5 - r.Stars))</span>
                    </div>
                    @if (!string.IsNullOrEmpty(r.Comment))
                    {
                        <p class="text-muted small mb-0 mt-2">@r.Comment</p>
                    }
                    <small class="text-muted mt-1">@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small>
                </div>
            </div>
        }
    </div>
}