@model UTHMBargain.Services.AdminAnalytics
@{
    ViewData["Title"] = "Analytics";
}

<div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <div>
        <h2 class="section-title mb-1">📊 Analytics Dashboard</h2>
        <p class="text-muted small mb-0">AI-powered insights · Last @Model.RangeDays days</p>
    </div>
    <div class="period-tabs btn-group">
        <a asp-action="Analytics" asp-route-days="7" class="btn btn-outline-light @(Model.RangeDays == 7 ? "active" : "")">7 days</a>
        <a asp-action="Analytics" asp-route-days="30" class="btn btn-outline-light @(Model.RangeDays == 30 ? "active" : "")">30 days</a>
        <a asp-action="Analytics" asp-route-days="90" class="btn btn-outline-light @(Model.RangeDays == 90 ? "active" : "")">90 days</a>
    </div>
</div>

<!-- ============ KPI CARDS ============ -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Revenue (@Model.RangeDays d)</div>
                    <div class="kpi-value">RM @Model.TotalRevenue.ToString("N2")</div>
                    <div class="kpi-trend @(Model.GrowthPercent >= 0 ? "up" : "down")">
                        @(Model.GrowthPercent >= 0 ? "▲" : "▼") @Math.Abs(Model.GrowthPercent)%
                    </div>
                </div>
                <div class="kpi-icon"><i class="fa-solid fa-dollar-sign"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Transactions</div>
                    <div class="kpi-value">@Model.TotalTransactions</div>
                    <div class="text-muted small mt-1">Lifetime: @Model.LifetimeTransactions</div>
                </div>
                <div class="kpi-icon"><i class="fa-solid fa-receipt"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Avg Order</div>
                    <div class="kpi-value">RM @Model.AvgOrderValue.ToString("N2")</div>
                    <div class="text-muted small mt-1">Per transaction</div>
                </div>
                <div class="kpi-icon"><i class="fa-solid fa-chart-line"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Active Escrows</div>
                    <div class="kpi-value">@Model.ActiveEscrows</div>
                    <div class="text-muted small mt-1">Disputes: @Model.OpenDisputes</div>
                </div>
                <div class="kpi-icon"><i class="fa-solid fa-shield-halved"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- ============ AI INSIGHTS ============ -->
<div class="row g-3 mb-4">
    <div class="col-lg-12">
        <div class="chart-card">
            <h6><i class="fa-solid fa-wand-magic-sparkles me-1 text-accent"></i> AI Insights</h6>
            @foreach (var insight in Model.Insights)
            {
                <div class="insight-box">@Html.Raw(insight.Replace("**", "<strong>").Replace("**", "</strong>").Replace("<strong>", "<strong>").Replace("</strong>", "</strong>"))</div>
            }
        </div>
    </div>
</div>

<!-- ============ REVENUE CHART ============ -->
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="chart-card">
            <h6>Revenue — Historical & AI Forecast</h6>
            <canvas id="revenueChart"></canvas>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="chart-card">
            <h6>Top Categories</h6>
            <canvas id="categoriesChart"></canvas>
        </div>
    </div>
</div>

<!-- ============ LEADERBOARDS ============ -->
<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="chart-card">
            <h6>🏆 Top Sellers</h6>
            @{
                var rank = 0;
            }
            @foreach (var s in Model.TopSellers)
            {
                rank++;
                var cls = rank == 1 ? "gold" : rank == 2 ? "silver" : rank == 3 ? "bronze" : "";
                <div class="leaderboard-item">
                    <div class="d-flex align-items-center">
                        <span class="rank @cls">@rank</span>
                        <span>@s.Name</span>
                    </div>
                    <span class="price-tag" style="font-size:.9rem;">RM @s.Amount.ToString("N2")</span>
                </div>
            }
            @if (!Model.TopSellers.Any())
            {
                <div class="text-muted small">No sales yet.</div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="chart-card">
            <h6>🛒 Top Buyers</h6>
            @{
                rank = 0;
            }
            @foreach (var b in Model.TopBuyers)
            {
                rank++;
                var cls = rank == 1 ? "gold" : rank == 2 ? "silver" : rank == 3 ? "bronze" : "";
                <div class="leaderboard-item">
                    <div class="d-flex align-items-center">
                        <span class="rank @cls">@rank</span>
                        <span>@b.Name</span>
                    </div>
                    <span class="price-tag" style="font-size:.9rem;">RM @b.Amount.ToString("N2")</span>
                </div>
            }
            @if (!Model.TopBuyers.Any())
            {
                <div class="text-muted small">No purchases yet.</div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="chart-card">
            <h6>🥇 Top Products</h6>
            @{
                rank = 0;
            }
            @foreach (var p in Model.TopProducts)
            {
                rank++;
                var cls = rank == 1 ? "gold" : rank == 2 ? "silver" : rank == 3 ? "bronze" : "";
                <div class="leaderboard-item">
                    <div class="d-flex align-items-center">
                        <span class="rank @cls">@rank</span>
                        <span class="text-truncate" style="max-width:180px;">@p.Title</span>
                    </div>
                    <span class="text-muted small">@p.Count × · RM @p.Revenue.ToString("N2")</span>
                </div>
            }
            @if (!Model.TopProducts.Any())
            {
                <div class="text-muted small">No sales yet.</div>
            }
        </div>
    </div>
</div>

<!-- ============ ANOMALIES ============ -->
@if (Model.Anomalies.Any())
{
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="chart-card">
                <h6><i class="fa-solid fa-triangle-exclamation me-1" style="color:var(--accent-red);"></i> AI Anomaly Detection</h6>
                @foreach (var a in Model.Anomalies)
                {
                    <div class="anomaly-item">
                        <div class="label">@a.Type · Z-score @a.ZScore</div>
                        <div>@a.Message</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // ==================== REVENUE CHART ====================
        const labels = [
                @Html.Raw(string.Join(",", Model.DailySeries.Select(d => $"'{d.Date:MMM dd}'"))),
                @Html.Raw(string.Join(",", Model.Forecast.Select(f => $"'{f.Date:MMM dd} (P)'")))
            ];

        const historical = [
                @Html.Raw(string.Join(",", Model.DailySeries.Select(d => d.Revenue.ToString(System.Globalization.CultureInfo.InvariantCulture))))
            ];

        // Pad historical for forecast align
        const pad = new Array(@Model.Forecast.Count).fill(null);
        const historicalPadded = historical.concat(pad);

        const forecastData = new Array(historical.length - 1).fill(null).concat([
            historical[historical.length - 1],
                @Html.Raw(string.Join(",", Model.Forecast.Select(f => f.Predicted.ToString(System.Globalization.CultureInfo.InvariantCulture))))
            ]);

        const forecastUpper = new Array(historical.length - 1).fill(null).concat([
            historical[historical.length - 1],
                @Html.Raw(string.Join(",", Model.Forecast.Select(f => f.UpperBound.ToString(System.Globalization.CultureInfo.InvariantCulture))))
            ]);

        const forecastLower = new Array(historical.length - 1).fill(null).concat([
            historical[historical.length - 1],
                @Html.Raw(string.Join(",", Model.Forecast.Select(f => f.LowerBound.ToString(System.Globalization.CultureInfo.InvariantCulture))))
            ]);

        new Chart(document.getElementById('revenueChart'), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Revenue',
                        data: historicalPadded,
                        borderColor: '#c8ff3a',
                        backgroundColor: 'rgba(200,255,58,0.1)',
                        fill: true,
                        tension: 0.35,
                        pointRadius: 3,
                        pointBackgroundColor: '#c8ff3a',
                        borderWidth: 2
                    },
                    {
                        label: 'AI Forecast',
                        data: forecastData,
                        borderColor: '#ffd166',
                        borderDash: [6, 4],
                        fill: false,
                        tension: 0.35,
                        pointRadius: 3,
                        pointBackgroundColor: '#ffd166',
                        borderWidth: 2
                    },
                    {
                        label: 'Upper Bound',
                        data: forecastUpper,
                        borderColor: 'rgba(255,209,102,0.3)',
                        fill: false,
                        pointRadius: 0,
                        borderWidth: 1
                    },
                    {
                        label: 'Lower Bound',
                        data: forecastLower,
                        borderColor: 'rgba(255,209,102,0.3)',
                        backgroundColor: 'rgba(255,209,102,0.08)',
                        fill: '-1',
                        pointRadius: 0,
                        borderWidth: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { labels: { color: '#9aa0a6', font: { family: 'Sora' } } },
                    tooltip: {
                        backgroundColor: '#1f2226',
                        titleColor: '#c8ff3a',
                        bodyColor: '#eef0f2',
                        borderColor: '#2a2e33',
                        borderWidth: 1,
                        callbacks: {
                            label: function(ctx) {
                                return ctx.dataset.label + ': RM ' + (ctx.parsed.y !== null ? ctx.parsed.y.toFixed(2) : '0.00');
                            }
                        }
                    }
                },
                scales: {
                    x: { ticks: { color: '#9aa0a6' }, grid: { color: '#2a2e33' } },
                    y: { ticks: { color: '#9aa0a6', callback: v => 'RM ' + v }, grid: { color: '#2a2e33' } }
                }
            }
        });

        // ==================== CATEGORIES CHART ====================
        @if (Model.TopCategories.Any())
            {
                <text>
                        new Chart(document.getElementById('categoriesChart'), {
                            type: 'doughnut',
                        data: {
                            labels: [@Html.Raw(string.Join(",", Model.TopCategories.Select(c => $"'{c.Name}'")))],
                        datasets: [{
                            data: [@Html.Raw(string.Join(",", Model.TopCategories.Select(c => c.Revenue.ToString(System.Globalization.CultureInfo.InvariantCulture))))],
                        backgroundColor: ['#c8ff3a', '#ffd166', '#6bd968', '#78b4ff', '#ff5c5c'],
                        borderColor: '#17191c',
                        borderWidth: 3
                                }]
                            },
                        options: {
                            responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {position: 'bottom', labels: {color: '#9aa0a6', font: {family: 'Sora', size: 11 } } }
                                }
                            }
                        });
                </text>
        }
    </script>
}