@model UTHMBargain.Models.ApplicationUser
@{
    ViewData["Title"] = "Wallet";
    var txs = (List<UTHMBargain.Models.WalletTransaction>)ViewBag.Transactions;
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="wallet-card">
            <div class="d-flex justify-content-between align-items-center">
                <div class="text-muted small">Your Balance</div>
                <i class="fa-solid fa-wallet text-accent fa-lg"></i>
            </div>
            <div class="my-3 wallet-balance">RM @Model.WalletBalance.ToString("F2")</div>
            <div class="small text-muted">@Model.FullName · @Model.MatricNumber</div>
        </div>

        <div class="card p-3 mt-3">
            <h6 class="fw-semibold">Top Up</h6>
            <form asp-action="TopUp" method="post" class="d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="number" step="0.01" name="Amount" min="1" max="10000" class="form-control" placeholder="Amount (RM)" required />
                <button class="btn btn-primary-accent"><i class="fa-solid fa-plus"></i></button>
            </form>
            <small class="text-muted">Simulated top-up for demo purposes.</small>
        </div>

        <div class="card p-3 mt-3">
            <h6 class="fw-semibold">Withdraw</h6>
            <form asp-action="Withdraw" method="post" class="d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="number" step="0.01" name="amount" min="1" class="form-control" placeholder="Amount (RM)" required />
                <button class="btn btn-outline-light"><i class="fa-solid fa-arrow-down"></i></button>
            </form>
            <small class="text-muted">Simulated withdrawal for demo purposes.</small>
        </div>
    </div>

    <div class="col-lg-7">
        <h2 class="section-title">Recent Transactions</h2>
        @if (!txs.Any())
        {
            <div class="empty"><i class="fa-solid fa-receipt"></i><p>No transactions yet.</p></div>
        }
        else
        {
            <div class="card">
                <table class="table mb-0">
                    <thead><tr><th>Date</th><th>Type</th><th>Reference</th><th class="text-end">Amount</th></tr></thead>
                    <tbody>
                        @foreach (var t in txs)
                        {
                            <tr>
                                <td><small class="text-muted">@t.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small></td>
                                <td>@t.Type</td>
                                <td><small class="text-muted">@t.Reference</small></td>
                                <td class="text-end" style="color:@(t.Amount >= 0 ? "var(--success)" : "var(--accent-red)");font-family:'JetBrains Mono',monospace;">
                                    @(t.Amount >= 0 ? "+" : "")RM @t.Amount.ToString("F2")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>