@model UTHMBargain.Models.ViewModels.ProductFormViewModel
@{
    ViewData["Title"] = "Edit Listing";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h2 class="section-title">Edit Listing</h2>
        <div class="card p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div>
                <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="5" class="form-control"></textarea></div>
                <div class="row">
                    <div class="col-md-4 mb-3"><label class="form-label">Price</label><input asp-for="Price" type="number" step="0.01" class="form-control" /></div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" class="form-select">
                            @foreach (var c in Model.Categories!)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Condition" class="form-label"></label>
                        <select asp-for="Condition" class="form-select">
                            @foreach (var v in Enum.GetValues<UTHMBargain.Models.ProductCondition>())
                            {
                                <option value="@v">@v</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Location" class="form-label"></label>
                    <select asp-for="Location" class="form-select"><option>Parit Raja</option><option>Pagoh</option></select>
                </div>

                @if (Model.ExistingImages != null && Model.ExistingImages.Any())
                {
                    <div class="mb-3">
                        <label class="form-label">Current Images</label>
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var img in Model.ExistingImages)
                            {
                                <img src="@img.Url" style="width:80px;height:80px;object-fit:cover;border-radius:8px;border:1px solid var(--border);" />
                            }
                        </div>
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label">Add More Images</label>
                    <input type="file" name="Images" multiple accept="image/*" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary-accent"><i class="fa-solid fa-check me-1"></i> Save Changes</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-light">Cancel</a>
            </form>
        </div>
    </div>
</div>