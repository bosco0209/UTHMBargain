@model UTHMBargain.Models.ViewModels.ProductFormViewModel
@{
    ViewData["Title"] = "Create Listing";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h2 class="section-title">Post a New Listing</h2>
        <div class="card p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Physics Textbook 2nd Edition" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" rows="5" class="form-control" placeholder="Describe condition, defects, why you're selling..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Price" class="form-label">Price (RM)</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" class="form-select">
                            <option value="">Choose category</option>
                            @foreach (var c in Model.Categories!)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Condition" class="form-label"></label>
                        <select asp-for="Condition" class="form-select">
                            @foreach (var v in Enum.GetValues<UTHMBargain.Models.ProductCondition>())
                            {
                                <option value="@v">@v</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Location" class="form-label"></label>
                    <select asp-for="Location" class="form-select">
                        <option>Parit Raja</option>
                        <option>Pagoh</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Product Images (up to 5)</label>
                    <input type="file" name="Images" multiple accept="image/*" class="form-control" />
                    <small class="text-muted">Max 5MB per image · JPG, PNG, WebP</small>
                </div>
                <button type="submit" class="btn btn-primary-accent btn-lg"><i class="fa-solid fa-check me-1"></i> Publish Listing</button>
                <a asp-action="Index" class="btn btn-outline-light">Cancel</a>
            </form>
        </div>
    </div>
</div>