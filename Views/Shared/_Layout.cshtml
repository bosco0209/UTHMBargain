<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · UTHM Bargain</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- App CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- ==================== NAVBAR ==================== -->
    <nav class="navbar navbar-expand-lg sticky-top main-nav">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-logo"><i class="fa-solid fa-graduation-cap"></i></span>
                <span class="brand-text">UTHM<span class="brand-accent">Bargain</span></span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Products" asp-action="Index">
                            <i class="fa-solid fa-store me-1"></i> Browse
                        </a>
                    </li>

                    @if (User.Identity!.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Create">
                                <i class="fa-solid fa-plus me-1"></i> Sell
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Messages" asp-action="Index">
                                <i class="fa-solid fa-comments me-1"></i> Messages
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Escrow" asp-action="Index">
                                <i class="fa-solid fa-shield-halved me-1"></i> Escrow
                            </a>
                        </li>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning" asp-controller="Admin" asp-action="Index">
                                <i class="fa-solid fa-crown me-1"></i> Admin
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning" asp-controller="Admin" asp-action="Analytics">
                                <i class="fa-solid fa-chart-pie me-1"></i> Analytics
                            </a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <!-- Wallet Button -->
                        <li class="nav-item me-2 d-flex align-items-center">
                            <a class="btn btn-wallet" asp-controller="Wallet" asp-action="Index">
                                <i class="fa-solid fa-wallet me-1"></i> Wallet
                            </a>
                        </li>

                        <!-- User Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-user-circle me-1"></i>
                                @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li>
                                    <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                                        <i class="fa-solid fa-user me-2"></i> My Profile
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Profile" asp-action="Dashboard">
                                        <i class="fa-solid fa-chart-line me-2"></i> My Dashboard
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Products" asp-action="MyListings">
                                        <i class="fa-solid fa-tag me-2"></i> My Listings
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Profile" asp-action="Edit">
                                        <i class="fa-solid fa-pen me-2"></i> Edit Profile
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-1">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                            <i class="fa-solid fa-right-from-bracket me-1"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="fa-solid fa-right-to-bracket me-1"></i> Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary-accent ms-2" asp-controller="Account" asp-action="Register">
                                Sign Up
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- ==================== MAIN CONTENT ==================== -->
    <main class="container py-4">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-circle-check me-1"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-triangle-exclamation me-1"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- ==================== FOOTER ==================== -->
    <footer class="site-footer mt-5">
        <div class="container">
            <div class="row py-4">
                <div class="col-md-6">
                    <div class="brand-text mb-2">
                        UTHM<span class="brand-accent">Bargain</span>
                    </div>
                    <p class="small mb-0">
                        Trusted campus marketplace with secure escrow · Made for UTHM students.
                    </p>
                </div>
                <div class="col-md-6 text-md-end small">
                    <p class="mb-1">
                        <i class="fa-solid fa-shield-halved me-1 text-accent"></i>
                        Escrow-protected transactions
                    </p>
                    <p class="mb-1">
                        <i class="fa-solid fa-user-check me-1 text-accent"></i>
                        Verified UTHM community
                    </p>
                    <p class="mb-0 text-muted">
                        &copy; @DateTime.Now.Year UTHM Bargain
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- ==================== SCRIPTS ==================== -->
    <!-- Chart.js (for analytics dashboards) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <!-- Bootstrap JS bundle (includes Popper.js — REQUIRED for dropdowns & modals) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>